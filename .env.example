NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/pr-0.db
PR0_WORKSPACE_ROOT=
DEFAULT_AGENT_MODE=supervised
MAX_CONCURRENT_TASKS=3
MAX_TOOL_STEPS_PER_TASK=40
MAX_RETRIES_PER_TASK=3
DEFAULT_TASK_TIMEOUT_MS=900000
MAX_TOOL_OUTPUT_BYTES=200000

# Local Ollama is the normal provider selection; the daemon must be running and have a model pulled.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-local-model-tag

# Optional hosted API integrations. Keep credentials server-side; the web client never receives them.
# OPENAI_API_KEY=your-secret-key
# OPENAI_MODEL=your-selected-model-id
# ANTHROPIC_API_KEY=your-secret-key
# ANTHROPIC_MODEL=your-selected-model-id
# GEMINI_API_KEY=your-secret-key
# GEMINI_MODEL=your-selected-model-id
# OPENROUTER_API_KEY=your-secret-key
# OPENROUTER_MODEL=openrouter/free
